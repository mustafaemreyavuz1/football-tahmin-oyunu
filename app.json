{
  "expo": {
    "name": "Football Tahmin Oyunu",
    "slug": "football-tahmin-oyunu",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "football-tahmin-oyunu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hobby.footballtahminoyunu"
    },
    "android": {
      "package": "com.hobby.footballtahminoyunu",
      "adaptiveIcon": {
        "backgroundColor": "#1B6B3A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1c69b312-48f2-4976-a00c-0a61c8a60a53"
      }
    }
  }
}
